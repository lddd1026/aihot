<!DOCTYPE html>
<html lang="zh-CN">
<head><meta charset="utf-8"><title>AI 热点日报</title></head>
<body style="margin:0;padding:0;background:#f2f3f5;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f2f3f5;padding:24px 12px;">
<tr><td align="center">
  <table role="presentation" width="680" cellpadding="0" cellspacing="0"
         style="width:680px;max-width:100%;background:#ffffff;border-radius:10px;overflow:hidden;">
    <tr><td style="padding:28px 32px 12px;font-family:'Microsoft YaHei',Arial,sans-serif;">
      <div style="font-size:26px;font-weight:bold;color:#1f2329;">🤖 AI 热点日报</div>
      <div style="font-size:14px;color:#8a9099;margin-top:6px;">{{ date_text }} · 第 {{ issue_no }} 期</div>
      <hr style="border:none;border-top:2px solid #1f2329;margin:16px 0 0;">
    </td></tr>

    {% if image_cid %}
    <tr><td style="padding:20px 32px 0;">
      <img src="cid:{{ image_cid }}" alt="AI 热点日报长图"
           style="width:100%;border:1px solid #eef0f3;border-radius:8px;display:block;">
      <div style="font-size:12px;color:#a9afb8;margin-top:6px;">（长图版，文字内容见下方）</div>
    </td></tr>
    {% endif %}

    {% if summary %}
    <tr><td style="padding:20px 32px 0;font-family:'Microsoft YaHei',Arial,sans-serif;">
      <div style="font-size:17px;font-weight:bold;color:#1f2329;margin-bottom:10px;">📌 今日综述</div>
      <div style="font-size:15px;line-height:1.85;color:#2b2f36;background:#f7f8fa;
                  border-left:4px solid #3370ff;border-radius:6px;padding:14px 16px;">{{ summary }}</div>
    </td></tr>
    {% endif %}

    {% if top_items %}
    <tr><td style="padding:24px 32px 0;font-family:'Microsoft YaHei',Arial,sans-serif;">
      <div style="font-size:17px;font-weight:bold;color:#1f2329;margin-bottom:6px;">🔥 今日必读</div>
      {% for item in top_items %}
      <div style="padding:14px 0;border-bottom:1px solid #eef0f3;">
        <div style="font-size:16px;font-weight:bold;line-height:1.5;color:#1f2329;">
          {{ loop.index }}. {{ item.title }}
        </div>
        {% if item.summary %}
        <div style="font-size:14px;line-height:1.75;color:#4e5969;margin-top:6px;">{{ item.summary }}</div>
        {% endif %}
        <div style="font-size:12px;color:#8a9099;margin-top:8px;">
          <span style="background:#eef4ff;color:#3370ff;border-radius:4px;padding:2px 8px;">{{ item.category }}</span>
          &nbsp;{{ item.mention_text }}
          {% for link in item.links[:3] %}
          &nbsp;·&nbsp;<a href="{{ link.url }}" style="color:#3370ff;text-decoration:none;">{{ link.source_id }}</a>
          {% endfor %}
        </div>
      </div>
      {% endfor %}
    </td></tr>
    {% endif %}

    {% if papers %}
    <tr><td style="padding:20px 32px 0;font-family:'Microsoft YaHei',Arial,sans-serif;">
      <div style="font-size:17px;font-weight:bold;color:#1f2329;margin-bottom:8px;">🔬 论文精选</div>
      {% for item in papers %}
      <div style="padding:10px 0;border-bottom:1px dashed #e5e8ef;">
        <div style="font-size:15px;font-weight:bold;line-height:1.5;">
          <a href="{{ item.url }}" style="color:#1f2329;text-decoration:none;">{{ item.title }}</a>
        </div>
        {% if item.summary %}
        <div style="font-size:13px;line-height:1.7;color:#4e5969;margin-top:6px;">{{ item.summary }}</div>
        {% endif %}
        <div style="font-size:12px;color:#7b61ff;margin-top:6px;">{{ item.note }}</div>
      </div>
      {% endfor %}
    </td></tr>
    {% endif %}

    {% if briefs %}
    <tr><td style="padding:20px 32px 0;font-family:'Microsoft YaHei',Arial,sans-serif;">
      <div style="font-size:17px;font-weight:bold;color:#1f2329;margin-bottom:8px;">📎 其他值得一看</div>
      {% for item in briefs %}
      <div style="font-size:14px;line-height:1.9;color:#2b2f36;">
        • <a href="{{ item.url }}" style="color:#1f2329;text-decoration:none;">{{ item.title }}</a>
        <span style="color:#8a9099;font-size:12px;">（{{ item.category }}）</span>
      </div>
      {% endfor %}
    </td></tr>
    {% endif %}

    <tr><td style="padding:24px 32px 28px;font-family:'Microsoft YaHei',Arial,sans-serif;">
      <hr style="border:none;border-top:1px solid #eef0f3;margin:0 0 12px;">
      <div style="font-size:12px;color:#8a9099;">
        共扫描 {{ stats.scanned }} 条 · 筛出 {{ stats.clusters }} 个事件 · 精选 {{ stats.selected }} 条 · 由 DeepSeek 加工
      </div>
    </td></tr>
  </table>
</td></tr>
</table>
</body>
</html>
